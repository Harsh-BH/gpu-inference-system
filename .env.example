# Copy to .env and edit. Every value here has a default in src/config.py --
# this file documents the knobs, it is not required for the system to boot.

# --- Model identity -----------------------------------------------------
# Resolved to: ${MODEL_REPOSITORY}/${MODEL_NAME}/${MODEL_VERSION}/
# Never hardcode a model path anywhere in src/.
MODEL_REPOSITORY=models
MODEL_NAME=resnet18
MODEL_VERSION=v1

# --- Execution ----------------------------------------------------------
# BACKEND selects the runtime. The API layer does not know which one is active.
#   pytorch      - eager PyTorch, the correctness baseline
#   onnxruntime  - ONNX Runtime w/ CUDA execution provider  (needs: uv sync --extra onnx)
#   tensorrt     - prebuilt TensorRT engine                 (needs: uv sync --extra trt)
BACKEND=pytorch

# fp32 | fp16. Never applied implicitly -- an engine must be asked for it.
PRECISION=fp32

# TF32 convolutions on Ampere+ Tensor Cores. PyTorch enables this BY DEFAULT
# and says nothing: tensors stay float32, but conv accumulation drops from 23
# mantissa bits to 10. Measured here on ResNet-18, max |gpu-cpu| on logits was
# 3.56e-03 with it on versus 5.25e-06 with it off.
# Off by default so "PyTorch FP32" is genuinely FP32 and can serve as the
# correctness baseline the other runtimes are compared against.
ALLOW_TF32=false

# cuda:0 | cpu. "cpu" is supported so the CPU-vs-GPU experiment is runnable.
DEVICE=cuda:0

# --- Preprocessing ------------------------------------------------------
IMAGE_SIZE=224

# --- Batching -----------------------------------------------------------
# A batch is dispatched when EITHER condition trips:
#   (a) MAX_BATCH_SIZE requests are queued, or
#   (b) the oldest waiting request has waited MAX_BATCH_WAIT_MS.
# Raising MAX_BATCH_WAIT_MS trades p99 latency for throughput.
MAX_BATCH_SIZE=8
MAX_BATCH_WAIT_MS=5

# --- Queue / backpressure ----------------------------------------------
# Bounded on purpose: an unbounded queue converts a load spike into an OOM
# kill instead of a 503. Overflow is rejected, not buffered.
QUEUE_MAX_SIZE=100
REQUEST_TIMEOUT_MS=10000

# --- Warmup -------------------------------------------------------------
# The first inference pays lazy CUDA context init, cuDNN autotuning and
# allocator growth. We pay it at boot instead of charging it to a user.
WARMUP_REQUESTS=10

# --- Limits / safety ----------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000

# --- Observability ------------------------------------------------------
LOG_LEVEL=INFO

# Preprocessing thread pool. One thread sustains ~46 img/s; the engine can
# absorb 700-3200, so this is what decides whether the GPU is ever fed.
PREPROCESS_WORKERS=8
